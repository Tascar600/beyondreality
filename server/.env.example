PORT=4040
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-before-deploy

# Email reminders — configure here OR use Reports → Email Setup in the portal
# Gmail example (use an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=finance@beyondreality.co.zw

# Outlook / Office 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=finance@yourcompany.com
# SMTP_PASS=your-password
# SMTP_FROM=finance@yourcompany.com
